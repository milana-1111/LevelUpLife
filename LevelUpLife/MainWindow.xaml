<Window x:Class="LevelUpLife.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Level Up Life" Height="620" Width="940" MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Обновить" Command="{Binding RefreshCommand}" InputGestureText="F5"/>
                <MenuItem Header="Выйти из _аккаунта" Command="{Binding LogoutCommand}"/>
                <Separator/>
                <MenuItem Header="В_ыход" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Привычки">
                <MenuItem Header="_Добавить..." Command="{Binding AddCommand}"/>
                <MenuItem Header="_Изменить..." Command="{Binding EditCommand}"/>
                <MenuItem Header="_Удалить" Command="{Binding DeleteCommand}"/>
                <Separator/>
                <MenuItem Header="О_тметить выполненной" Command="{Binding CompleteCommand}"/>
                <MenuItem Header="_Пропустить" Command="{Binding SkipCommand}"/>
            </MenuItem>
            <MenuItem Header="_Рейтинг">
                <MenuItem Header="_Таблица лидеров" Command="{Binding OpenLeaderboardCommand}"/>
            </MenuItem>
            <MenuItem Header="_Справка">
                <MenuItem Header="_О программе" Command="{Binding OpenAboutCommand}"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TodayText}" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Width="260">
                        <TextBlock FontSize="16" FontWeight="SemiBold">
                            <Run Text="Уровень "/>
                            <Run Text="{Binding Level, Mode=OneWay}"/>
                        </TextBlock>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}"
                                     Height="14" Margin="0,6,0,2" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                <TextBlock Text="Привычки" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <CheckBox Content="Показывать все привычки" IsChecked="{Binding ShowAll}"
                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>

            <DataGrid Grid.Row="2" ItemsSource="{Binding Habits}" SelectedItem="{Binding SelectedHabit, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeight="32" Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Привычка" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="150"/>
                    <DataGridTextColumn Header="Сложность" Binding="{Binding DifficultyText}" Width="110"/>
                    <DataGridTextColumn Header="Состояние" Binding="{Binding StatusText}" Width="120"/>
                    <DataGridTextColumn Header="XP" Binding="{Binding XpText}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Выполнено" Command="{Binding CompleteCommand}"
                            Background="{StaticResource AccentBrush}" Foreground="White"/>
                    <Button Content="Пропустить" Command="{Binding SkipCommand}"/>
                    <Button Content="Добавить" Command="{Binding AddCommand}"/>
                    <Button Content="Изменить" Command="{Binding EditCommand}"/>
                    <Button Content="Удалить" Command="{Binding DeleteCommand}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
