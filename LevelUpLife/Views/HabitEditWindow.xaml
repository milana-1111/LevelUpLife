<Window x:Class="LevelUpLife.Views.HabitEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}">
    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>
    <StackPanel Margin="24">
        <TextBlock Text="Название"/>
        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>

        <TextBlock Text="Категория"/>
        <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedCategory}"/>

        <TextBlock Text="Сложность"/>
        <ComboBox ItemsSource="{Binding DifficultyOptions}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedDifficulty}"/>

        <TextBlock Text="Дни недели" Margin="0,0,0,4"/>
        <ItemsControl ItemsSource="{Binding Days}" Margin="0,0,0,12">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="0,0,14,0"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" IsDefault="True"
                    Background="{StaticResource AccentBrush}" Foreground="White"/>
            <Button Content="Отмена" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
